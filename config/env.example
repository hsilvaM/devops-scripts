# Variables de entorno para configuracion

# Docker
DOCKER_NETWORK_NAME=app-network
DOCKER_REGISTRY=local-registry:5000

# Aplicaciones
NEXTJS_APP_NAME=nextjs-app
NESTJS_APP_NAME=nestjs-app
APP_PORT_NEXTJS=3000
APP_PORT_NESTJS=3001

# Base de datos Oracle
ORACLE_HOST=oracle-db
ORACLE_PORT=1521
ORACLE_SID=ORCL
ORACLE_USER=app_user
ORACLE_PASSWORD=changeme

# Jenkins
JENKINS_PORT=8080
JENKINS_HOME=/var/jenkins_home

# Monitoring
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# Firewall
FIREWALL_ZONE=public
FIREWALL_ENABLE_SERVICES=true
FIREWALL_ENABLE_PORTS=true
